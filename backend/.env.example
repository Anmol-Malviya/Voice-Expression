# VoiceExpression Backend Environment Variables
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_for_ai_manthan_ps16_assistive_app
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Database (Atlas or local; auto-fallback to async in-memory if empty)
MONGODB_URI=
MONGODB_DATABASE=ai_manthan

# AI Providers: ElevenLabs Speech Integration
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# AI Providers: OpenAI Conversational Intelligence
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (Optional multi-modal fallback)
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Conversational Context Window (Number of prior messages to feed into LLM)
AI_CONTEXT_WINDOW=10

