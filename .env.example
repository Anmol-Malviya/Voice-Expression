# ==========================================
# BACKEND CONFIGURATION (.env)
# ==========================================
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security
JWT_SECRET=super_secret_jwt_key_change_in_production_32bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (MongoDB Atlas)
# If empty or unreachable, the system automatically uses a robust async in-memory database fallback.
MONGODB_URI=
MONGODB_DATABASE=ai_manthan

# External AI Service Credentials (Optional - high-fidelity local fallback runs offline if omitted)
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
AI_CONTEXT_WINDOW=10

# ==========================================
# FRONTEND CONFIGURATION (.env)
# ==========================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000

